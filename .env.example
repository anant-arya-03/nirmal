# Node 24. Keep the default loopback binding for local development.
PORT=4173
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4173
DATABASE_PATH=./data/nirmal.sqlite
# Set the university domain without @ to restrict new registrations.
UNIVERSITY_EMAIL_DOMAIN=bennett.edu.in
# Production requires HTTPS and an SMTP provider. Never commit credentials.
NODE_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
